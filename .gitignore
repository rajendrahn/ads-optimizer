node_modules/
.env
.env.*

# Data exports — these carry customer data and must never enter source control.
# Matrixify exports arrive as .xlsx as well as .csv (see SETUP.md §3); the PII bucket
# gs://sng-meta-ads-optimizer-pii-imports is the only sanctioned home for them.
*.csv
*.xlsx
*.xls
Export_*

# Scratch files from exploratory/agent runs. These routinely hold live API responses
# (which have included real order and customer data), so they must never be committed.
_tmp_*
*.scratch.*

# Build output / tooling caches
functions/lib/
dist/
web/dist/
coverage/

# Firebase local emulator / CLI state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# E3's generated calibration report/dashboard (scripts/generateCalibrationReport.ts) — a
# point-in-time snapshot of live account data once any exists, regenerated on demand, never a
# source artifact.
/reports/
