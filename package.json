{
  "name": "ads-optimizer",
  "private": true,
  "type": "module",
  "scripts": {
    "verify-credentials": "tsx scripts/verify-credentials.ts",
    "verify-a4-clients": "tsx scripts/verify-a4-clients.ts",
    "verify-d3-reasoner": "firebase emulators:exec --only firestore \"tsx scripts/verify-d3-reasoner.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "lint:web": "eslint -c web/eslint.config.js web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:integration": "firebase emulators:exec --only firestore,auth \"vitest run -c vitest.emulator.config.ts\"",
    "check": "npm run typecheck && npm run lint && npm run lint:web && npm run format:check && npm run test && npm run test:web",
    "emulators": "firebase emulators:start --only firestore,auth,functions",
    "seed:web-demo": "firebase emulators:exec --only firestore,auth \"tsx web/server/seedDemo.ts\"",
    "dev:api": "tsx watch web/server/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/tasks": "^7.0.0",
    "csv-parse": "^7.0.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
