rules_version = '2';

// §17.1: Firestore rules deny all client reads and writes. Every document is served
// through the API (Cloud Run), which uses the Admin SDK and bypasses these rules entirely.
// A blanket deny on `{document=**}` already covers every collection in §8 (and any future
// one) identically, so there is no per-collection detail to add — §17.1 itself says as much
// ("with one account and a small user set this is a few lines, not a design problem").
// Proven against every collection by test/firestore.rules.emulator.test.ts (A2).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
