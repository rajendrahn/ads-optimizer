{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@services/*": ["services/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "services/**/*.ts",
    "test/**/*.ts",
    "web/server/**/*.ts"
  ],
  "exclude": ["node_modules", "functions", "web/src", "web/dist"]
}
